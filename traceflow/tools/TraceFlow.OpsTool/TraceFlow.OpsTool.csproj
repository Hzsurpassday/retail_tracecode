<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TraceFlow.OpsTool</RootNamespace>
    <AssemblyName>TraceFlow.OpsTool</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- perf 用 WebApplicationFactory<Program>（引用 Host 的项目内进程托管）。 -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" Version="2.1.35" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\db\tools\TraceFlow.DbMigrator\TraceFlow.DbMigrator.csproj" />
    <ProjectReference Include="..\..\src\TraceFlow.Host\TraceFlow.Host.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- perf 迁移脚本目录固定为输出目录下 db/migrations（MigrationRunner 约定）。 -->
    <Content Include="..\..\db\migrations\*.sql" Link="db\migrations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>